# На сервере: cp .env.example .env && chmod 600 .env
# docker compose подхватит .env автоматически (см. docker-compose.yml).

# Токен бота от @BotFather. Без него процесс сразу упадёт при старте.
BOT_TOKEN=

# URL SQLite для sqlx. В контейнере путь относительно WORKDIR (/app);
# volume compose монтирует ./data сервера в /app/data — база переживёт пересборку образа.
DATABASE_URL=sqlite://data/rusty_key.db

# Уровень логов tracing (например info, debug). См. RUST_LOG / tracing-subscriber.
RUST_LOG=info
